# GPS.mac
# Вариант 1: КОНУС (телесный угол)
# Источник в точке (-5.0, 0.0, -5.0) см.
# Ось конуса направлена на центр пластины (0, 0, -5) см.

/gps/source/clear
/gps/source/add 1

/gps/particle gamma
/gps/ene/type Mono
/gps/ene/mono 80.0 keV

/gps/pos/type Point
/gps/pos/centre -5.0 0.0 -5.0 cm

# --- НАСТРОЙКА КОНУСА ---
# cos - равномерное распределение по телесному углу
/gps/ang/type cos
# Поворот оси конуса. Вектор направления: (+1.0, 0, 0) вдоль оси X.
/gps/ang/rot1 0.0 1.0 0.0
/gps/ang/rot2 0.0 0.0 1.0
# Углы конуса
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 15 deg
