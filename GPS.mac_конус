# GPS.mac
# Протяжённый пучок с угловым разбросом (гауссово распределение)
# Пучок летит вдоль оси X (после поворота)

/gps/source/clear
/gps/source/add 1

/gps/particle gamma
/gps/ene/type Mono
/gps/ene/mono 80.0 keV

/gps/pos/type Point
/gps/pos/centre -5.0 0.0 -5.0 cm

# Задаём направление пучка вдоль +X
/gps/ang/type beam2d
/gps/ang/rot1 0 0 1
/gps/ang/rot2 0 1 0
/gps/ang/sigma_x 5.0 deg
/gps/ang/sigma_y 5.0 deg
