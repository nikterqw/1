# GPS.mac
# Изотропный источник с ограничением по углу (конус)

/gps/source/clear
/gps/source/add 1

/gps/particle gamma
/gps/ene/type Mono
/gps/ene/mono 80.0 keV

/gps/pos/type Point
/gps/pos/centre -5.0 0.0 -5.0 cm

# Изотропно, но только в конусе 15 градусов
/gps/ang/type iso
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 15 deg
