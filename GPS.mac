# GPS.mac
# Первичный пучок 80 кэВ сбоку, фокус на металлическую сферу (0,0,-5) см.

/gps/source/clear
/gps/source/add 1
/gps/particle gamma
/gps/ene/type Mono
/gps/ene/mono 80.0 keV

/gps/pos/type Point
/gps/pos/centre 5.0 0.0 -5.0 cm

/gps/ang/type focus
/gps/ang/focuspoint 0.0 0.0 -5.0 cm
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 5 deg
