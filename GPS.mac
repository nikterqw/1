# GPS.mac
# Первичный пучок 80 кэВ из точки S = (3.5355, 0, -1.4645) см,
# фокус на центр металлической пластины M = (0, 0, -5) см.
# Пучок падает на пластину по нормали (пластина повёрнута на 45° вокруг Y).

/gps/source/clear
/gps/source/add 1

/gps/particle gamma
/gps/ene/type Mono
/gps/ene/mono 80.0 keV

/gps/pos/type Point
/gps/pos/centre -5.0 0.0 -5.0 cm

/gps/ang/type focused
/gps/ang/focuspoint 0.0 0.0 -5.0 cm
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 15 deg
